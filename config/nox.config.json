{
  "name": "NOX",
  "version": "3.0.0",
  "server": {
    "host": "127.0.0.1",
    "port": 8765
  },
  "llamaServer": {
    "baseUrl": "http://127.0.0.1:8080",
    "model": "qwen2.5-0.5b-instruct-q4_k_m",
    "context": 1024,
    "threads": 4,
    "maxTokens": 256,
    "temperature": 0.7
  },
  "assistant": {
    "language": "pt-BR",
    "wakeWord": "Nox",
    "systemPrompt": "Você é NOX, assistente pessoal local do senhor Gustavo. Responda sempre em português do Brasil. Chame o usuário de senhor Gustavo. Seja natural, claro, objetivo e amigável. Dê respostas curtas por padrão, especialmente no celular. Não invente informações. Se não souber, diga que não sabe."
  },
  "mobile": {
    "enabled": true,
    "defaultServerUrl": "http://127.0.0.1:8766",
    "gatewayPort": 8766,
    "websocketPath": "/ws",
    "wakeWord": "NOX",
    "tapToTalk": true,
    "requirePairingToken": true
  },
  "memory": {
    "engine": "sqlite",
    "path": "memory/nox.db",
    "persistent": true
  },
  "commands": {
    "enabled": true,
    "allowlist": [
      "status",
      "pwd",
      "git status"
    ]
  },
  "webLearning": {
    "enabled": true,
    "continuous": true,
    "intervalMinutes": 360,
    "startupDelaySeconds": 60,
    "maxQueriesPerCycle": 2,
    "maxResultsPerQuery": 2,
    "maxCharsPerPage": 4200,
    "maxPageBytes": 800000,
    "timeoutMs": 7000,
    "maxStoredItems": 150,
    "topics": [
      "inteligência artificial, tecnologia e novidades de computação",
      "programação JavaScript, Node.js e desenvolvimento de software",
      "ciência, educação e conhecimentos gerais"
    ]
  }
}
